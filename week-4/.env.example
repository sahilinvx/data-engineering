# Copy this file to .env and fill in real values. .env is gitignored.

# --- GitHub API (task 01) ---
# Optional. Without a token GitHub allows 60 unauthenticated requests/hour
# per IP. With a token it's 5000/hour. Create one at
# https://github.com/settings/tokens (no scopes needed for public data).
GITHUB_TOKEN=

# --- Postgres (tasks 02 & 03, matches docker-compose.yml defaults) ---
PGHOST=localhost
PGPORT=5433
PGUSER=de_student
PGPASSWORD=de_student_pw
PGDATABASE=week4
