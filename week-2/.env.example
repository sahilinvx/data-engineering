# Copy this file to .env and adjust values as needed.
# Anything set here overrides the matching value in config/config.ini.
# .env itself is gitignored — this .example file is the template that IS committed,
# so teammates know which variables exist without seeing real secrets.

# LOG_LEVEL=DEBUG
# API_BASE_URL=https://jsonplaceholder.typicode.com
# REQUEST_TIMEOUT=10
# OUTPUT_DIR=output
